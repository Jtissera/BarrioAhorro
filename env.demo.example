# En el Codespace: cp env.demo.example .env.demo   y completar.
# .env.demo NO se sube a git (está en .gitignore).

# Panel de ngrok -> Your Authtoken
NGROK_AUTHTOKEN=
# Panel de ngrok -> Domains (sin https:// ni barra final). Ej.: abc123.ngrok-free.dev
NGROK_DOMAIN=

POSTGRES_DB=barrioahorro
POSTGRES_USER=barrioahorro
POSTGRES_PASSWORD=cambiar-por-una-clave

# Cualquier texto largo y aleatorio. Generar con: openssl rand -base64 48
JWT_SECRET=

# Con onboarding@resend.dev solo se entrega al mail de tu cuenta de Resend.
RESEND_API_KEY=
EMAIL_FROM=BarrioAhorro <onboarding@resend.dev>
